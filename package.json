{
  "name": "vitehub-calories",
  "private": true,
  "type": "module",
  "imports": {
    "#vitehub/env/server": {
      "types": "./.vitehub/env/server.d.ts",
      "default": "./.vitehub/env/server.mjs"
    }
  },
  "scripts": {
    "build": "node --env-file-if-exists=.env node_modules/nuxt/bin/nuxt.mjs build",
    "data:export": "tsx scripts/export-data.ts",
    "data:export:database": "tsx scripts/export-data.ts --database-only",
    "deploy": "pnpm run build && wrangler deploy --config .output/server/wrangler.json --keep-vars --strict",
    "db:generate": "node --env-file-if-exists=.env node_modules/vite-hub/dist/bin.js db generate",
    "db:migrate": "mkdir -p .vitehub/data/database && node --env-file-if-exists=.env node_modules/vite-hub/dist/bin.js db migrate",
    "db:migrate:remote": "pnpm run build && wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json",
    "dev": "node --env-file-if-exists=.env node_modules/nuxt/bin/nuxt.mjs dev --host 127.0.0.1 --port 3000",
    "postinstall": "vitehub types prepare && nuxt prepare --envName development",
    "preview": "node --env-file-if-exists=.env node_modules/nuxt/bin/nuxt.mjs preview",
    "provision:cloudflare": "node --env-file=.env node_modules/vite-hub/dist/bin.js provision run --provider cloudflare",
    "telegram:history": "node --env-file=.env node_modules/vite-hub/dist/bin.js channels history --agent calories --channel telegram --stage production --output .backups/telegram-history",
    "telegram:webhook": "node --env-file=.env node_modules/vite-hub/dist/bin.js channels sync --agent calories --channel telegram --stage production",
    "telegram:webhook:apply": "node --env-file=.env node_modules/vite-hub/dist/bin.js channels sync --agent calories --channel telegram --stage production --apply",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "node --env-file-if-exists=.env node_modules/nuxt/bin/nuxt.mjs prepare --envName development && vue-tsc --build --noEmit",
    "doctor": "vite-doctor . --max-warnings 0"
  },
  "dependencies": {
    "@cf-wasm/photon": "0.4.0",
    "@nuxt/ui": "4.11.3",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@vueuse/core": "15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "ai": "7.0.130",
    "drizzle-orm": "0.45.3",
    "image-meta": "0.3.0",
    "nuxt": "npm:nuxt-nightly@5.0.0-2610071710-0296ca4",
    "tailwindcss": "4.3.3",
    "vite-hub": "https://pkg.pr.new/vite-hub/vitehub/vite-hub@5fabe01c2e9faa990bbe4014bc1e5ef144530435",
    "vue-router": "5.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261007.1",
    "@iconify-json/lucide": "1.2.140",
    "@iconify-json/ph": "1.2.2",
    "@types/node": "24.19.1",
    "chokidar": "5.0.0",
    "miniflare": "4.20260730.0",
    "nitro": "3.0.260903-beta",
    "nuxt-skill-hub": "0.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vite-doctor": "https://pkg.pr.new/onmax/vite-doctor/vite-doctor@3189acdd03ad09466b7efa4d1b813f580f9c6cdb",
    "vue-tsc": "3.3.12",
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@10.33.2"
}
