+        <div v-else-if="list.isLoading.value && sessions.length === 0" class="vh-console__skeletons">
+          <USkeleton v-for="index in 5" :key="index" class="h-20 w-full rounded-lg" />
+        </div>
+
+        <div v-else-if="sessions.length === 0" class="vh-console__empty">
+          <UIcon name="i-lucide-orbit" />
+          <strong>No sessions yet</strong>
+          <p>The first Agent invocation will appear here automatically.</p>
+        </div>
+
+        <div v-else class="vh-console__session-list">
+          <button
+            v-for="session in sessions"
+            :key="session.id"
+            class="vh-console__session"
+            :class="{ 'is-selected': selectedSession?.id === session.id }"
+            :aria-pressed="selectedSession?.id === session.id"
+            type="button"
+            @click="selectSession(session)"
+          >
+            <span class="vh-console__session-copy">
+              <strong>{{ sessionTitle(session) }}</strong>
+              <small>{{ shortId(session.id) }}</small>
+            </span>
+            <span class="vh-console__session-meta">
+              <time :datetime="session.updatedAt">{{ formatTime(session.updatedAt) }}</time>
+              <span>{{ session.invocations.length }} run{{ session.invocations.length === 1 ? "" : "s" }}</span>
+            </span>
+          </button>
+
+          <UButton
+            v-if="list.cursor.value"
+            block
+            color="neutral"
+            label="Load older"
+            size="sm"
+            variant="soft"
+            :loading="list.isLoadingMore.value"
+            @click="list.loadMore"
