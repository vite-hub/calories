+import { mkdirSync } from "node:fs";
+import { resolve } from "node:path";
+import { createLibsqlAgentInvocationStore } from "vite-hub/agent/invocations/sqlite";
+import { defineAgentInvocations } from "vite-hub/agent/server";
+
+const consoleInvocationsKey = Symbol.for("vitehub.console.invocations");
+
+function getConsoleInvocations() {
+	if (!globalThis[consoleInvocationsKey]) {
+		const dataDirectory = resolve(process.cwd(), ".vitehub/data");
+		mkdirSync(dataDirectory, { recursive: true });
+		globalThis[consoleInvocationsKey] = defineAgentInvocations({
+			store: createLibsqlAgentInvocationStore({ url: `file:${resolve(dataDirectory, "console.sqlite")}` })
+		});
+	}
+	return globalThis[consoleInvocationsKey];
+}
+
+export { getConsoleInvocations };
