+      const reduced = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
+      target.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "center" });
+      window.clearTimeout(jumpToCall.timer);
+      jumpToCall.timer = window.setTimeout(() => target.classList.remove("vh-tool-call-target"), 1800);
+    }));
+  }
+
+  function enhanceThread() {
+    for (const list of document.querySelectorAll(".vh-invocation-activities")) {
+      const work = list.querySelector(":scope > .vh-invocation-work");
+      if (work) {
+        let anchor = work;
+        for (const delivery of list.querySelectorAll(":scope > .vh-invocation-activity[data-kind=\"delivery\"]")) {
+          if (anchor.nextElementSibling !== delivery) anchor.after(delivery);
+          anchor = delivery;
+        }
+      }
+      for (const message of list.querySelectorAll(":scope > .vh-invocation-message")) {
+        if (message.querySelector(":scope > .vh-channel")) continue;
+        const role = message.dataset.role === "user" ? "User" : message.dataset.role === "assistant" ? "Assistant" : undefined;
+        if (role) message.prepend(channelMeta(role));
+      }
+      for (const delivery of list.querySelectorAll(":scope > .vh-invocation-activity[data-kind=\"delivery\"]")) {
+        const body = delivery.querySelector(".vh-invocation-delivery__body");
+        if (body && !body.querySelector(":scope > .vh-channel")) body.prepend(channelMeta("Assistant"));
+      }
+    }
+  }
+
+  function enhanceEffects() {
+    for (const activity of document.querySelectorAll(".vh-invocation-activity[data-kind=\"system\"]")) {
+      if (activity.dataset.vhEffect === "true") continue;
+      const summary = activity.querySelector(".vh-invocation-event__summary");
+      const title = summary?.querySelector(".vh-invocation-event__title");
+      if (!summary || title?.textContent?.trim() !== "Agent configured") continue;
+      const suffix = summary.querySelector(".vh-invocation-event__suffix");
+      const parts = suffix?.textContent?.split("·").map((part) => part.trim()).filter(Boolean) ?? [];
+      const capabilities = parts.find((part) => /capabilit(?:y|ies)$/i.test(part));
+      const tools = parts.find((part) => /tools?$/i.test(part));
+      const configuredModel = parts.find((part) => part !== capabilities && part !== tools);
+      const counts = [capabilities, tools].filter(Boolean);
+      const effectDetail = counts.length > 1 ? `${counts[0]} and ${counts[1]}` : counts[0];
+      const label = configuredModel
+        ? `Configured ${modelName(configuredModel)}${effectDetail ? ` with ${effectDetail}` : ""}`
+        : `Configured${effectDetail ? ` ${effectDetail}` : " agent"}`;
+      title.textContent = label;
+      suffix?.remove();
+      summary.querySelector(".vh-invocation-event__icon")?.replaceChildren(viteHubMark());
+      activity.classList.add("vh-vitehub-effect");
+      activity.dataset.vhEffect = "true";
+      summary.setAttribute("aria-label", label);
+    }
+  }
+
+  function relativeTime(value) {
+    const date = new Date(value);
+    if (!Number.isFinite(date.getTime())) return;
+    const elapsed = Math.max(0, Date.now() - date.getTime());
+    const minute = 60_000;
+    const hour = 60 * minute;
+    const day = 24 * hour;
+    const month = 30 * day;
+    const year = 365 * day;
+    const full = new Intl.DateTimeFormat("en", { dateStyle: "medium", timeStyle: "short" }).format(date);
+    if (elapsed < minute) return { full, label: "now", short: "now" };
+    const [amount, unit, suffix] = elapsed < hour
+      ? [Math.floor(elapsed / minute), "minute", "m"]
+      : elapsed < day
+        ? [Math.floor(elapsed / hour), "hour", "h"]
+        : elapsed < month
+          ? [Math.floor(elapsed / day), "day", "d"]
+          : elapsed < year
+            ? [Math.floor(elapsed / month), "month", "mo"]
+            : [Math.floor(elapsed / year), "year", "y"];
+    return {
+      full,
+      label: new Intl.RelativeTimeFormat("en", { numeric: "always" }).format(-amount, unit),
+      short: `${amount}${suffix}`,
+    };
+  }
+
+  function enhanceTimes() {
+    for (const time of document.querySelectorAll(".vh-invocation-list__state time[datetime]")) {
+      const relative = relativeTime(time.dateTime);
+      if (!relative) continue;
+      if (time.textContent !== relative.short) time.textContent = relative.short;
+      time.title = relative.full;
+      time.setAttribute("aria-label", `${relative.label}; ${relative.full}`);
+    }
+  }
+
+  function enhanceSidebar(config) {
+    const maker = modelMaker(config?.driver?.model?.id);
