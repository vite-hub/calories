+import { defineAgent as defineUpstreamAgent } from "@vite-hub/agent";
 export * from "@vite-hub/agent";
+
+const consoleInvocationsKey = Symbol.for("vitehub.console.invocations");
+function defineAgent(options) {
+	const agent = defineUpstreamAgent(options);
+	let assignedInvocations;
+	if (!agent.invocations) Object.defineProperty(agent, "invocations", {
+		configurable: true,
+		enumerable: true,
+		get() {
+			return assignedInvocations || globalThis[consoleInvocationsKey];
+		},
+		set(value) {
+			assignedInvocations = value;
+		}
+	});
+	return agent;
+}
+export { defineAgent };
 export {};
