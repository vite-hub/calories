+          button.addEventListener("click", () => showToast(`${label} copied`));
+        }
+      }
+    }
+  }
+
+  function enhance() {
+    scheduled = false;
+    enhanceThread();
+    enhanceEffects();
+    enhanceHeader();
+    const config = configuration();
+    enhanceSidebar(config);
+    enhanceTimes();
+    if (!detail || !config || !Array.isArray(config.tools)) return;
+    for (const inspector of document.querySelectorAll(".vh-invocation-inspector")) {
+      simplifyInspector(inspector);
+      const groups = inspector.querySelector(".vh-invocation-inspector__groups");
+      if (!groups) continue;
+      for (const group of groups.querySelectorAll(":scope > .vh-invocation-inspector__group")) {
