+        model.title = `${maker.label} model`;
+        model.append(brandMark(maker, "vh-sidebar-model__logo"), element("span", "vh-visually-hidden", `${maker.label} model`));
+        marks.push(model);
+      }
+      harness.replaceChildren(...marks);
+    }
+  }
+
+  function enhanceHeader() {
+    const panel = document.querySelector("#vitehub-console-v2-panel-agent-session");
+    const actions = panel?.querySelector(".vitehub-console__session-navbar [data-slot=\"right\"]");
+    if (!actions) return;
+    const completed = Boolean(panel.querySelector("[data-slot=\"invocation\"][data-status=\"completed\"]"));
+    const refresh = actions.querySelector("button[aria-label=\"Refresh session\"]");
+    if (refresh) refresh.hidden = completed;
+    if (!actions.querySelector(".vh-copy-link")) {
+      const button = element("button", "vh-copy-link");
+      button.type = "button";
+      button.setAttribute("aria-label", "Copy session link");
+      button.title = "Copy session link";
