+<script setup lang="ts">
+import { useHead, useRoute, useRouter } from "#imports";
+import { AgentInvocation } from "@vite-hub/ui";
+import { useAgentInvocation, useAgentInvocations } from "vite-hub/agent/vue";
+import { computed, ref, watch } from "vue";
+
+import type {
+  AgentInvocationRecordStatus,
+  AgentInvocationSummary,
+} from "vite-hub/agent";
+import type { AgentInvocationView } from "@vite-hub/ui";
+
+type ConsoleSession = {
+  agentName?: string;
+  id: string;
+  invocations: AgentInvocationSummary[];
+  updatedAt: string;
+};
+
+const route = useRoute();
+const router = useRouter();
+const refreshedAt = ref<Date>();
+const selectedInvocationId = ref<string>();
+const apiBase = "/api/_vitehub/console/invocations";
+
+useHead({ title: "Agents · ViteHub Console" });
+
+const request = async <T,>(path: string, options: { signal?: AbortSignal }) => {
+  const response = await fetch(path, { signal: options.signal });
+  if (!response.ok) throw new Error(`Console request failed with status ${response.status}.`);
+  return await response.json() as T;
+};
+
+const list = useAgentInvocations({
+  baseURL: apiBase,
+  pollInterval: 5_000,
+  request,
+});
+const detail = useAgentInvocation(selectedInvocationId, {
+  baseURL: apiBase,
+  pollInterval: 3_000,
+  request,
+});
+
+const sessions = computed<ConsoleSession[]>(() => {
+  const grouped = new Map<string, ConsoleSession>();
+  for (const invocation of list.invocations.value) {
+    const id = invocation.threadId || invocation.id;
+    const session = grouped.get(id);
+    if (session) {
+      session.invocations.push(invocation);
+      continue;
+    }
+    grouped.set(id, {
+      agentName: invocation.agentName,
+      id,
+      invocations: [invocation],
+      updatedAt: invocation.updatedAt,
+    });
+  }
+  return [...grouped.values()];
+});
+
+const routeSession = computed(() => {
+  const value = route.params.session;
+  return Array.isArray(value) ? value[0] : value;
+});
+const selectedSession = computed(() =>
+  sessions.value.find(session => session.id === routeSession.value),
+);
+const invocationView = computed<AgentInvocationView | undefined>(() => {
+  const invocation = detail.invocation.value;
+  if (!invocation) return;
+  return { ...invocation, observations: detail.observations.value };
+});
+const listError = computed(() => errorMessage(list.error.value));
+const detailError = computed(() => errorMessage(detail.error.value));
+
+function errorMessage(error: unknown) {
+  return error instanceof Error ? error.message : error ? "The console could not load this data." : undefined;
+}
+
+function statusTone(status: AgentInvocationRecordStatus) {
+  if (status === "failed") return "error";
+  if (status === "completed") return "success";
+  if (status === "running") return "warning";
+  return "neutral";
+}
+
+function formatTime(value: string) {
+  const date = new Date(value);
+  return Number.isNaN(date.valueOf())
+    ? value
+    : new Intl.DateTimeFormat(undefined, {
+        day: "numeric",
+        hour: "2-digit",
+        minute: "2-digit",
+        month: "short",
+      }).format(date);
+}
+
+function shortId(value: string) {
+  return value.length > 18 ? `${value.slice(0, 8)}…${value.slice(-6)}` : value;
+}
+
+function sessionTitle(session: ConsoleSession) {
+  return session.agentName || "Agent session";
+}
+
+async function selectSession(session: ConsoleSession) {
+  await router.push({
+    name: "vitehub-console-agents",
+    params: { session: session.id },
+  });
+}
+
+async function refresh() {
+  await Promise.all([list.refresh(), detail.refresh()]);
+  refreshedAt.value = new Date();
+}
+
+watch(sessions, async (next) => {
+  if (next.length === 0) return;
+  const selected = next.find(session => session.id === routeSession.value);
+  if (!selected) await selectSession(next[0]!);
+  refreshedAt.value = new Date();
+}, { immediate: true });
+
+watch(selectedSession, (session) => {
+  if (!session) {
+    selectedInvocationId.value = undefined;
+    return;
+  }
+  if (!session.invocations.some(invocation => invocation.id === selectedInvocationId.value)) {
+    selectedInvocationId.value = session.invocations[0]?.id;
+  }
+}, { immediate: true });
+</script>
