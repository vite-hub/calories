+  padding: 0.55rem 0.65rem;
+  transition: border-color 140ms ease, color 140ms ease, transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
+  width: 100%;
+}
+
+.vh-invocation-identifiers .vh-invocation-inspector__copy:last-child {
+  justify-self: stretch;
+}
+
+.vh-invocation-identifiers .vh-invocation-inspector__copy-state {
+  display: none;
+}
+
+.vh-invocation-identifiers .vh-invocation-inspector__copy-label {
+  font-size: 0.6875rem;
+  font-weight: 550;
+}
+
+.vh-invocation-identifiers .vh-invocation-inspector__copy-icon {
+  color: var(--vh-ui-dimmed);
+}
+
+.vh-invocation-identifiers .vh-invocation-inspector__copy:active {
+  transform: scale(0.985);
+}
+
+.vh-invocation-identifiers .vh-invocation-inspector__copy:focus-visible {
+  outline: 2px solid var(--vh-ui-text);
+  outline-offset: 2px;
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .vh-invocation-identifiers .vh-invocation-inspector__copy:hover {
+    border-color: var(--vh-ui-border-accented, var(--vh-ui-border));
+    color: var(--vh-ui-text);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .vh-copy-link,
+  .vh-console-toast,
+  summary.vh-invocation-tool-list__summary::after,
+  .vh-invocation-identifiers .vh-invocation-inspector__copy {
+    transform: none;
+    transition: opacity 150ms ease;
+  }
+
+  .vh-console-toast[data-visible="true"] {
+    transform: none;
+  }
+}
