+      let summary = activity.querySelector(".vh-invocation-event__summary");
+      const title = summary?.querySelector(".vh-invocation-event__title");
+      if (!summary || (activity.dataset.vhEffect !== "true" && title?.textContent?.trim() !== "Agent configured")) continue;
+      if (activity.dataset.vhEffect !== "true") {
