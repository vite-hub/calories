new file mode 100644
index 0000000000000000000000000000000000000000..b9024913e385c28fa6b5bb0c81912b7289fcd0bf
--- /dev/null
+++ b/dist/console/runtime/public/console/console-message-overrides.css
@@ -0,0 +1,146 @@
+.vitehub-console__sessions div:has(> button[disabled][aria-haspopup="menu"]) {
+  display: none;
+}
+
+.vitehub-console__sessions button:has(> [data-slot="trailing"] kbd) {
+  border: 1px solid var(--vh-ui-border);
+}
+
+.vitehub-console__sessions button:has(> [data-slot="trailing"] kbd) > [data-slot="trailing"] {
+  opacity: 0;
+  pointer-events: none;
+  transform: translateX(0.25rem);
+  transition:
+    opacity 150ms ease,
+    transform 150ms cubic-bezier(0.23, 1, 0.32, 1);
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .vitehub-console__sessions button:has(> [data-slot="trailing"] kbd):hover > [data-slot="trailing"] {
+    opacity: 0.75;
+    transform: translateX(0);
+  }
+}
+
+.vitehub-console__sessions button:has(> [data-slot="trailing"] kbd):focus-visible > [data-slot="trailing"] {
+  opacity: 0.75;
+  transform: translateX(0);
+}
+
+.vh-invocation-message {
+  --vh-invocation-message-bg: color-mix(in oklab, var(--vh-ui-bg-elevated) 34%, transparent);
+  background: var(--vh-invocation-message-bg);
+  border: 1px solid var(--vh-ui-border);
+  border-radius: 1rem;
+  display: flex;
+  flex-direction: column;
+  gap: 0.35rem;
+  margin-block: 0.5rem 1rem;
+  max-width: 82%;
+  min-width: 0;
+  padding: 0.75rem 0.875rem;
+}
+
+.vh-invocation-message[data-role="assistant"] {
+  border-start-start-radius: 0.375rem;
+  margin-inline-end: auto;
+}
+
+.vh-invocation-message[data-role="user"] {
+  --vh-invocation-message-bg: var(--vh-ui-bg-elevated);
+  border-end-end-radius: 0.375rem;
+  margin-inline-start: auto;
+}
+
+.vh-invocation-message > .vh-visually-hidden:first-child {
+  clip: auto;
+  clip-path: none;
+  color: var(--vh-ui-dimmed);
+  font-size: 0;
+  font-weight: 600;
+  height: auto;
+  line-height: 1;
+  overflow: visible;
+  position: static;
+  white-space: normal;
+  width: auto;
+}
+
+.vh-invocation-message > .vh-visually-hidden:first-child::after {
+  font-size: 0.6875rem;
+}
+
+.vh-invocation-message[data-role="user"] > .vh-visually-hidden:first-child::after {
+  content: "You";
+}
+
+.vh-invocation-message[data-role="assistant"] > .vh-visually-hidden:first-child::after {
+  content: "Assistant";
+}
+
+.vh-invocation-message[data-role="system"] > .vh-visually-hidden:first-child::after {
+  content: "System";
+}
+
+.vh-invocation-message[data-role="tool"] > .vh-visually-hidden:first-child::after {
+  content: "Tool";
+}
+
+.vh-invocation-message__content[data-collapsed="true"]::after {
+  background: linear-gradient(to bottom, transparent, var(--vh-invocation-message-bg));
+}
+
+.vh-invocation-delivery__body {
+  --vh-invocation-message-bg: color-mix(in oklab, var(--vh-ui-bg-elevated) 34%, transparent);
+  background: var(--vh-invocation-message-bg);
+  border: 1px solid var(--vh-ui-border);
+  border-radius: 0.375rem 1rem 1rem 1rem;
+  color: var(--vh-ui-text);
+  display: flex;
+  flex-direction: column;
+  gap: 0.35rem;
+  margin: 0.35rem 0 1rem 2rem;
+  max-width: min(42rem, calc(82% - 2rem));
+  padding: 0.75rem 0.875rem;
+}
+
+.vh-invocation-delivery__body::before {
+  color: var(--vh-ui-dimmed);
+  content: "Assistant";
+  font-size: 0.6875rem;
+  font-weight: 600;
+  line-height: 1;
+}
+
+.vh-invocation-delivery__body .vh-invocation-event__markdown {
+  font-size: 0.875rem;
+  line-height: 1.625;
+  padding: 0;
+}
+
+@container (max-width: 600px) {
+  .vh-invocation-message {
+    max-width: calc(100% - 1rem);
+  }
+
+  .vh-invocation-delivery__body {
+    max-width: calc(100% - 3rem);
+  }
+}
+
+@media (max-width: 600px) {
+  .vh-invocation-message {
+    max-width: calc(100% - 1rem);
+  }
+
+  .vh-invocation-delivery__body {
+    max-width: calc(100% - 3rem);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .vitehub-console__sessions button:has(> [data-slot="trailing"] kbd) > [data-slot="trailing"] {
+    transform: none;
+    transition: opacity 150ms ease;
+  }
+}
