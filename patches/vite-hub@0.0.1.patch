+          <i aria-hidden="true" />
+          Read-only
+        </span>
+        <span v-if="refreshedAt" class="vh-console__updated">
+          Updated {{ formatTime(refreshedAt.toISOString()) }}
+        </span>
+        <UButton
+          color="neutral"
+          icon="i-lucide-refresh-cw"
+          label="Refresh"
+          size="sm"
+          variant="outline"
+          :loading="list.isLoading.value"
+          @click="refresh"
+        />
+      </div>
+    </header>
+
+    <div class="vh-console__workspace">
+      <nav class="vh-console__nav" aria-label="ViteHub Console">
+        <p>Workspace</p>
+        <NuxtLink class="vh-console__nav-item" to="/_vitehub/agents" aria-current="page">
+          <UIcon name="i-lucide-bot" />
+          <span>Agents</span>
+          <small>{{ sessions.length }}</small>
+        </NuxtLink>
+      </nav>
+
+      <aside class="vh-console__sessions" aria-label="Agent sessions">
+        <header class="vh-console__section-heading">
+          <div>
+            <p>Agents</p>
+            <h1>Sessions</h1>
+          </div>
+          <UBadge color="neutral" variant="subtle">{{ sessions.length }}</UBadge>
+        </header>
+
+        <div v-if="listError" class="vh-console__notice" role="alert">
+          <strong>Console unavailable</strong>
