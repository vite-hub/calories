+++ b/dist/console/runtime/server/invocation.get.js
@@ -0,0 +1,11 @@
+import { createError, defineEventHandler, getRouterParam } from "h3";
+import { getConsoleInvocations } from "./invocations.js";
+import { assertLocalConsoleRequest } from "./local-request.js";
+
+export default defineEventHandler(async (event) => {
+	assertLocalConsoleRequest(event);
+	const invocation = await getConsoleInvocations().get(getRouterParam(event, "id") || "");
+	if (!invocation) throw createError({ statusCode: 404, statusMessage: "Invocation not found" });
+	const { observations, ...summary } = invocation;
