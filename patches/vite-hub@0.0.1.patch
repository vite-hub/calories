+    }
+  }
+
+  function simplifyInspector(inspector) {
+    inspector.querySelector(".vh-invocation-inspector__identity")?.remove();
+    const metrics = inspector.querySelector(".vh-invocation-inspector__metrics");
+    if (metrics) {
+      const existing = Object.fromEntries([...metrics.querySelectorAll(":scope > div")].map((metric) => [metric.querySelector("dt")?.textContent?.trim().toLowerCase(), metric.querySelector("dd")?.textContent?.trim()]));
+      const calls = [...usageCounts().values()].reduce((sum, count) => sum + count, 0);
+      const duration = totalDuration();
+      const signature = `${existing.message ?? existing.messages}:${existing.step ?? existing.steps}:${calls}:${duration}`;
+      if (metrics.dataset.compact !== signature) {
+        metrics.dataset.compact = signature;
+        metrics.replaceChildren();
+        for (const [label, value] of [["Messages", existing.message ?? existing.messages ?? "0"], ["Steps", existing.step ?? existing.steps ?? "0"], ["Tool calls", String(calls)], ["Total time", duration ?? "—"]]) {
+          const metric = element("div");
+          metric.append(element("dt", "", label), element("dd", "", value));
+          metrics.append(metric);
+        }
+      }
+      metrics.parentElement?.querySelector(":scope > h4")?.remove();
+    }
+    inspector.querySelector(".vh-invocation-inspector__notice")?.remove();
+    const setup = inspector.querySelector(".vh-invocation-inspector__groups")?.parentElement;
